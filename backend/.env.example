# Backend Environment Variables
# Copy this file to .env and update with your values

# Database
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=ecommerce_db;Username=postgres;Password=YOUR_PASSWORD_HERE

# JWT Settings
JWT_SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_HERE_CHANGE_THIS_IN_PRODUCTION
JWT_ISSUER=ECommerceAPI
JWT_AUDIENCE=ECommerceClient
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000

# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7001;http://localhost:5001

# Email (optional, for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Storage (optional)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
